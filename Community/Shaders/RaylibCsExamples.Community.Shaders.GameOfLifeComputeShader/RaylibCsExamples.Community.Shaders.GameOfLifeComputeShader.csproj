<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="resources/shaders/glsl430/game_of_life.glsl" CopyToOutputDirectory="Always" />
    <Content Include="resources/shaders/glsl430/game_of_life_transfert.glsl" CopyToOutputDirectory="Always" />
    <Content Include="resources/shaders/glsl430/game_of_life_render.glsl" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
